rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own save data
    match /users/{userId}/saves/{saveId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Every save's payload lives in the chunks subcollection (small saves
      // = 1 chunk; parent docs are metadata-only — see cloudSync.js).
      match /chunks/{chunkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Portrait blobs are content-addressed and shared by every save slot that
    // shows them (one doc per portrait, written only when absent — see
    // cloudSync.js, 2026-09-22). Each save's metadata lists its portraitRefs.
    match /users/{userId}/portraits/{portraitId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chronicle chapter prose takes the same split (2026-09-26): one
    // content-addressed doc per chapter, shared by every slot whose metadata
    // lists it in chapterRefs — the cloud twin of the IndexedDB v5 store.
    match /users/{userId}/chronicleChapters/{chapterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
